// ============================================================================
// Solar Pixel — Prisma Schema
// ============================================================================
// ARCHITECTURE NOTE — Vendor Cost Isolation (Business Rule #2)
// ----------------------------------------------------------------------------
// `RawVendorCost` and `MarginRule` live in a separate Postgres schema
// ("vendor_private") from every client/engineer-facing table ("public"),
// using Prisma's multiSchema feature. This is a real DB-level boundary, not
// just an app-layer convention:
//
//   1. Run once against the database before the first migration:
//        CREATE SCHEMA IF NOT EXISTS vendor_private;
//
//   2. Create a restricted Postgres role for the Next.js/API service that
//      serves Field Engineer & Client requests, and explicitly deny it
//      access to the private schema:
//        REVOKE ALL ON SCHEMA vendor_private FROM app_public_role;
//        GRANT USAGE ON SCHEMA public TO app_public_role;
//
//   3. Only a separate Super-Admin-only service (or a dedicated internal
//      API route protected by role middleware) connects with a Postgres
//      role that has USAGE + SELECT/INSERT/UPDATE on vendor_private.
//
// Prisma itself does not enforce row/schema-level security — the DB role
// separation above is what guarantees `raw_vendor_costs` and `margin_rules`
// can never leak through a client-facing query, even if application code
// has a bug. The client-safe output of these tables (a final sale price,
// already margin-inclusive) is written onto `Quote.finalPriceRs`, which
// DOES live in the public schema — that's the only bridge between the two
// worlds, and it only ever carries a price, never a cost or margin %.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Connection URL + driver adapter now live in prisma.config.ts (Prisma 7+).
// `schemas` stays here: it's what actually splits our models across the
// public / vendor_private Postgres schemas (see note above).
datasource db {
  provider = "postgresql"
  schemas  = ["public", "vendor_private"]
}

// ============================================================================
// ENUMS
// ============================================================================

// ADMIN added 2026-08-20 for the delegated internal-tool access model —
// see AdminModuleGrant's doc comment below for the full scheme. There is
// exactly ONE SUPER_ADMIN in practice (the seeded row in prisma/seed.ts)
// and it keeps authenticating via the ADMIN_ACCESS_TOKEN shared secret
// (lib/auth/internal-guard.ts), same as before this change — that row
// exists purely so other tables (AdminModuleGrant.grantedById,
// User.createdByAdminId) have a real actor to attribute admin-management
// actions to, not because Super Admin login goes through the User table.
// ADMIN-role users are the new thing: each gets their own per-user access
// code (User.accessCodeHash) and only reaches the specific admin modules
// (LEADS/CHECKER) a Super Admin has granted them — see
// lib/auth/internal-guard.ts's assertAdminModuleAccess().
enum Role {
  SUPER_ADMIN
  ADMIN
  FIELD_ENGINEER
  CLIENT

  @@schema("public")
}

// The internal admin tools an ADMIN-role user can be individually
// granted access to. Deliberately does NOT include /admin/pricing —
// vendor cost/margin data stays Super-Admin-only unconditionally
// (assertSuperAdminAccess(), never assertAdminModuleAccess()) regardless
// of what any Admin is granted; adding a PRICING value here would be a
// meaningful, deliberate policy change, not just "add an enum value".
enum AdminModule {
  LEADS
  CHECKER

  @@schema("public")
}

enum Sector {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL

  @@schema("public")
}

// Market-reality constraint (2026, revised): Industrial is locked to
// ONGRID_ZERO_EXPORT exclusively (battery economics don't work at that
// load scale) — enforced server-side in app/api/quote/calculate, not
// just in the UI, see resolveServiceType() there. Residential defaults
// to HYBRID_BATTERY (recommended, for outage backup) but customers may
// opt into ONGRID_ZERO_EXPORT — the UI shows a warning about losing
// backup power during outages when they do. Commercial freely picks
// either with no warning either way.
enum ServiceType {
  HYBRID_BATTERY // Grid-tied + battery backup. Still zero-export — batteries
  // absorb excess instead of exporting to the grid.
  ONGRID_ZERO_EXPORT // Grid-tied, no battery, offloads daytime peak load only.

  @@schema("public")
}

// How the monthly bill figure on a Quote was obtained. Automated LESCO
// scraping was tried and abandoned (see app/api/bill-upload's module doc
// — the real portal gates bill data behind a CAPTCHA that isn't
// automatable) in favor of the customer uploading their own bill
// document, which we parse (PDF text / OCR) with their consent.
enum BillSource {
  MANUAL // typed in directly
  UPLOADED_PDF // parsed from an uploaded bill PDF
  UPLOADED_IMAGE // parsed from an uploaded bill photo/screenshot (OCR)

  @@schema("public")
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK_ADS
  GOOGLE_ADS
  REFERRAL
  WALK_IN
  OTHER

  @@schema("public")
}

// Sales-pipeline status for the Internal Admin Lead Dashboard
// (app/admin/leads). Distinct from QuoteStatus (the maker-checker
// technical BOQ workflow, e.g. MAKER_SUBMITTED/CHECKER_APPROVED) — this
// is the CRM-style funnel a sales rep moves a Lead through by hand.
// Renamed from an earlier, never-actually-used QUOTED/CONVERTED pairing
// (confirmed zero reads/writes anywhere in the app and zero non-NEW rows
// in the DB before this change, so this was a safe in-place rename, not
// a data migration) to match the pipeline the dashboard brief specified.
enum LeadStatus {
  NEW
  CONTACTED
  SURVEY_BOOKED
  WON
  LOST

  @@schema("public")
}

// Maker-checker lifecycle (Business Rule #3)
enum QuoteStatus {
  AUTOMATED_ESTIMATE // Instant web quote, no human touch yet
  SURVEY_SCHEDULED // Field Engineer assigned, visit pending
  MAKER_SUBMITTED // Field Engineer submitted measured BOQ
  CHECKER_APPROVED // Super Admin verified margins & approved
  REVISION_REQUESTED // Checker sent BOQ back to Maker
  DISPATCHED // Binding contract sent via WhatsApp
  REJECTED // Lead/quote dead

  @@schema("public")
}

enum RoofType {
  RCC_CONCRETE
  CORRUGATED_METALLIC
  GROUND_MOUNT

  @@schema("public")
}

// Logged, non-confidential workflow events (status transitions, approvals,
// dispatches). MUST NEVER contain raw vendor costs or margin % in
// `metadata` — those stay inside vendor_private and out of this table on
// principle, same as everywhere else in this schema. Lives in "public"
// specifically so it's safe for any authorized internal role to query.
enum AuditAction {
  QUOTE_MAKER_SUBMITTED
  QUOTE_CHECKER_APPROVED
  QUOTE_REVISION_REQUESTED
  QUOTE_REJECTED
  QUOTE_DISPATCHED

  @@schema("public")
}

// Shared between BoqItem (public) and RawVendorCost (vendor_private)
enum ComponentType {
  SOLAR_PANEL
  INVERTER
  BATTERY // HYBRID_BATTERY systems only — see ServiceType
  DC_CABLE
  AC_CABLE
  BREAKERS // Protection & breakers (DB box) — distinct from DB_UPGRADE,
  // which is a conditional survey-time cost for upgrading a customer's
  // EXISTING panel; BREAKERS is a standard component of every new system.
  MOUNTING_STRUCTURE
  DB_UPGRADE
  CT_COIL
  EARTHING
  LABOR
  TRANSPORT
  OTHER

  @@schema("public")
}

enum CostUnit {
  PER_WATT
  PER_METER
  PER_KWH // battery capacity — see BATTERY doc on ComponentType
  PER_UNIT
  PER_PIECE
  LUMP_SUM

  @@schema("vendor_private")
}

// ============================================================================
// PUBLIC SCHEMA — client, engineer & admin-facing data
// ============================================================================

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  phone        String  @unique
  // Legacy/unused — no password-based login flow was ever built (see the
  // "no login system yet" comments throughout prisma/seed.ts). Every real
  // internal-tool credential is a shared secret (MAKER/ADMIN_ACCESS_TOKEN)
  // or, for ADMIN-role users, `accessCodeHash` below — never this field.
  passwordHash String
  role         Role    @default(CLIENT)
  isActive     Boolean @default(true)

  // ---- ADMIN-role per-user access code (2026-08-20) ----
  // SHA-256 hex digest of a random per-admin access code — see
  // lib/auth/internal-guard.ts's hashAccessCode()/assertAdminModuleAccess().
  // Null for every non-ADMIN user (SUPER_ADMIN keeps using the
  // ADMIN_ACCESS_TOKEN env-var secret unconditionally, unaffected by this
  // column) and null for an ADMIN user momentarily between "created" and
  // "code issued" — in practice both happen atomically in one request, so
  // that gap doesn't really occur. Storing a HASH (not the plaintext code)
  // is a real, cheap security improvement over the single-shared-secret
  // model this replaces: a DB read alone can never recover a working code,
  // and each Admin's code can be individually rotated/revoked without
  // affecting anyone else — impossible when everyone shares one secret.
  accessCodeHash String? @unique

  // Which Super Admin created this ADMIN-role account — self-relation,
  // informational/audit only (see AdminModuleGrant's doc comment for why
  // this points at the real seeded SUPER_ADMIN row rather than requiring
  // Super Admin to have a per-request session identity).
  createdByAdminId String?
  createdByAdmin   User?   @relation("AdminCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAdmins    User[]  @relation("AdminCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ADMIN: which internal modules (Leads/Checker) this user can reach
  adminModuleGrants AdminModuleGrant[] @relation("AdminModuleGrantUser")
  // SUPER_ADMIN: module grants they issued to an ADMIN user
  moduleGrantsIssued AdminModuleGrant[] @relation("AdminModuleGrantIssuedBy")

  // CLIENT: lead(s)/account this user converted from, if any
  leadsAsClient Lead[] @relation("LeadClientUser")

  // FIELD_ENGINEER: site surveys they personally conducted
  siteSurveys SiteSurvey[] @relation("SurveyEngineer")

  // FIELD_ENGINEER: BOQ line items they (as Maker) entered
  boqItemsAdded BoqItem[] @relation("BoqItemAddedBy")

  // FIELD_ENGINEER: quotes they (as Maker) submitted a measured BOQ for
  quotesMakerSubmitted Quote[] @relation("QuoteMakerSubmitted")

  // SUPER_ADMIN: quotes they (as Checker) approved
  quotesApproved Quote[] @relation("QuoteCheckerApproved")

  // SUPER_ADMIN: vendor cost & margin records they authored
  vendorCostsCreated RawVendorCost[] @relation("VendorCostCreatedBy")
  marginRulesCreated MarginRule[]   @relation("MarginRuleCreatedBy")

  // SUPER_ADMIN: sector-installation-rate / add-on-service-rate settings
  // updates they made (see GlobalPricingSettings)
  globalPricingSettingsUpdated GlobalPricingSettings[] @relation("GlobalPricingSettingsUpdatedBy")

  // Workflow actions this user performed (approvals, dispatches, etc.)
  auditLogsAsActor AuditLog[] @relation("AuditLogActor")

  @@index([role])
  @@map("users")
  @@schema("public")
}

// Which internal modules (AdminModule) an ADMIN-role User can reach — a
// Super Admin grants/revokes these individually per Admin (multiple rows
// per user, one per module). `assertAdminModuleAccess()` in
// lib/auth/internal-guard.ts is the ONLY place this table's grants are
// actually enforced; every /admin/leads and /admin/checker API route goes
// through it. `grantedById` points at the real seeded SUPER_ADMIN `User`
// row (see Role's doc comment) — Super Admin login itself never goes
// through the User table, this FK exists purely so grants have a real
// actor to attribute to, the same reasoning AuditLog.actorId already
// established elsewhere in this schema.
model AdminModuleGrant {
  id String @id @default(cuid())

  userId String
  user   User   @relation("AdminModuleGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  module AdminModule

  grantedAt   DateTime @default(now())
  grantedById String
  grantedBy   User     @relation("AdminModuleGrantIssuedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, module])
  @@index([userId])
  @@map("admin_module_grants")
  @@schema("public")
}

model Lead {
  id       String     @id @default(cuid())
  fullName String
  phone    String
  email    String?
  city     String
  address  String?
  sector   Sector
  source   LeadSource @default(WEBSITE)
  status   LeadStatus @default(NEW)

  // Captured at first contact, used to seed the automated estimate
  monthlyBillRs Decimal @db.Decimal(12, 2)

  // Set once this lead creates/links a portal account
  clientUserId String?
  clientUser   User?   @relation("LeadClientUser", fields: [clientUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([phone])
  @@index([sector])
  @@index([status])
  @@map("leads")
  @@schema("public")
}

model Quote {
  id          String @id @default(cuid())
  quoteNumber String @unique // e.g. SP-2026-000123

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  sector      Sector // denormalized copy of Lead.sector for fast filtering
  serviceType ServiceType // Industrial-locked to ONGRID_ZERO_EXPORT; Residential/Commercial are customer choice — see resolveServiceType() in app/api/quote/calculate/route.ts
  status      QuoteStatus @default(AUTOMATED_ESTIMATE)

  // ---- Stage 1: Automated Estimate ----
  monthlyBillRs           Decimal @db.Decimal(12, 2) // input at estimate time
  blendedTariffRsPerUnit  Decimal @db.Decimal(8, 2) // PKR/unit tariff used
  estimatedDaytimeLoadKw  Decimal @db.Decimal(8, 3)
  estimatedSystemSizeKw   Decimal @db.Decimal(8, 3)
  automatedEstimatePriceRs Decimal @db.Decimal(14, 2) // instant web quote price

  // Provenance of monthlyBillRs — see BillSource doc.
  billSource BillSource @default(MANUAL)

  // Public URL of the customer's uploaded bill (PDF or photo), if any —
  // saved by /api/bill-upload via lib/storage/local.ts's
  // saveUploadedBillFile, surfaced to the Super Admin in the Checker
  // dashboard (GET /api/admin/checker/quotes) so it can be cross-checked
  // against the OCR'd figures before approval. Null on MANUAL billSource
  // or if the save itself failed (OCR result still usable either way —
  // see bill-upload's route.ts for why that's non-fatal).
  uploadedBillFileUrl String?

  // Snapshot of the Custom Equipment Builder selections (EquipmentOption
  // codes per component, chosen battery capacity, "Other" free-text notes)
  // — null means the Recommended path was used. Client-safe: codes/labels
  // only, never a cost. See lib/db/admin.ts's EquipmentSelections type,
  // which this mirrors.
  equipmentSelections Json?

  // Snapshot of lib/db/admin.ts's ResolvedEquipment / ItemizedBreakdown
  // DTOs at the moment this quote was priced — the ACTUAL brand/model
  // resolved for each slot (Recommended or Custom path alike) and the
  // already-marked-up per-category price split. Both are cost-free,
  // client-safe shapes (never a raw vendor cost or margin %, see those
  // types' own doc comments) — captured here, rather than recomputed on
  // every read, so the Admin Lead Dashboard's detail drawer (and the
  // customer's own BOQ report) always shows exactly what was quoted at
  // submission time, even if catalog prices/margins change later. Null
  // only for quotes created before this snapshot existed — the read path
  // falls back to a live recompute via calculateSystemPricing() for those.
  resolvedEquipmentSnapshot Json?
  breakdownSnapshot         Json?

  // ---- Stage 2: Maker Submission (Field Engineer) ----
  siteSurvey          SiteSurvey?
  boqItems            BoqItem[]
  auditLogs           AuditLog[]
  finalSystemSizeKw   Decimal?  @db.Decimal(8, 3)
  makerSubmittedAt    DateTime?
  makerSubmittedById  String?
  makerSubmittedBy    User?     @relation("QuoteMakerSubmitted", fields: [makerSubmittedById], references: [id], onDelete: SetNull)

  // ---- Stage 3: Checker Approval (Super Admin) ----
  // Client-safe, margin-inclusive final price. This is the ONLY financial
  // figure derived from vendor_private data that is allowed to exist here.
  finalPriceRs       Decimal?  @db.Decimal(14, 2)
  // Contractually-confirmed battery capacity (HYBRID_BATTERY quotes
  // only) — the Checker can edit/confirm this in /admin/checker before
  // approving (defaults to the pre-survey equipmentSelections estimate),
  // and it's what the final BOQ/contract price is actually based on.
  // Null for ONGRID_ZERO_EXPORT quotes. See calculateAdminBoqPricing's
  // `finalBatteryCapacityKwh` input in lib/db/admin.ts.
  finalBatteryCapacityKwh Decimal? @db.Decimal(8, 3)
  checkerApprovedAt  DateTime?
  checkerApprovedById String?
  checkerApprovedBy  User?     @relation("QuoteCheckerApproved", fields: [checkerApprovedById], references: [id], onDelete: SetNull)
  revisionNotes      String?   @db.Text
  rejectionReason    String?   @db.Text

  // ---- Stage 4: Dispatch (WhatsApp binding contract) ----
  contractPdfUrl      String?
  whatsappDispatchedAt DateTime?
  whatsappMessageId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([sector])
  @@map("quotes")
  @@schema("public")
}

model SiteSurvey {
  id String @id @default(cuid())

  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  engineerId String
  engineer   User   @relation("SurveyEngineer", fields: [engineerId], references: [id], onDelete: Restrict)

  visitDate DateTime

  // Exact measured BOQ inputs (Business Rule #3 / #4)
  dcCableMeters   Decimal @db.Decimal(8, 2)
  dcCableSpec     String? // e.g. "6mm² solar DC cable"
  acCableMeters   Decimal @db.Decimal(8, 2)
  acCableSpec     String? // e.g. "4mm² AC cable"
  dataCableMeters Decimal @db.Decimal(8, 2) // comms wiring for the CT Coil / Zero-Export Smart Meter

  roofType RoofType

  // "STANDARD_L1_L2" | "CUSTOM_ELEVATED" — enforced at the app layer (Zod),
  // not as a DB enum, so pricing (lib/db/admin.ts) can look up the matching
  // RawVendorCost by this exact string without a schema migration.
  structureChoice String

  roofAreaSqft     Decimal? @db.Decimal(10, 2)
  tiltAngleDegrees Decimal? @db.Decimal(5, 2)
  shadingIssues    Boolean  @default(false)
  shadingNotes     String?  @db.Text

  dbUpgradeRequired Boolean @default(false)
  dbUpgradeDetails  String? @db.Text

  // CT coil data (needed for zero-export load monitoring/offload logic)
  ctCoilRating String? // e.g. "100A/5A"
  ctCoilQty    Int?

  earthingPitsRequired Int?

  // Field-Engineer-confirmed battery request (HYBRID_BATTERY quotes only,
  // null otherwise) — captured on-site because the customer's actual need
  // often differs from the pre-survey web estimate (Quote.equipmentSelections'
  // batteryCapacityKwh). Purely a data point for the Checker: it PRE-FILLS
  // (does not replace) the editable "Final Approved Battery Capacity" field
  // in /admin/checker, which remains the source of truth calculateAdminBoqPricing
  // actually prices with. See finalBatteryCapacityKwh on Quote above.
  surveyedBatteryCapacityKwh Decimal? @db.Decimal(8, 3)

  // Labeled photo evidence: { dbBox, roof, meter } -> uploaded URL (or
  // null if not captured). Json instead of a plain string[] so a photo's
  // purpose is never inferred from array order.
  photos        Json?
  engineerNotes String? @db.Text

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([engineerId])
  @@map("site_surveys")
  @@schema("public")
}

// Itemized BOQ the Maker enters and the Checker reviews against margin
// rules. `rawVendorCostId` lets the Checker's admin-only view join across
// to vendor_private for cost/margin verification; that join must only ever
// be executed by the Super-Admin-scoped service.
model BoqItem {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  componentType ComponentType
  description   String
  brand         String?
  model         String?

  quantity Decimal @db.Decimal(10, 2)
  unit     String // "WATT" | "METER" | "PIECE" | "UNIT"

  // Client-visible price only — never the raw vendor cost.
  clientUnitPriceRs  Decimal @db.Decimal(12, 2)
  clientLineTotalRs  Decimal @db.Decimal(14, 2)

  // Optional cross-schema reference for Super-Admin margin verification.
  rawVendorCostId String?
  rawVendorCost   RawVendorCost? @relation(fields: [rawVendorCostId], references: [id], onDelete: SetNull)

  addedById String
  addedBy   User   @relation("BoqItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@index([componentType])
  @@map("boq_items")
  @@schema("public")
}

// Append-only workflow audit trail. See AuditAction's doc comment: this
// table is public-schema and MUST stay free of raw costs / margin %.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  // Denormalized snapshot so the log stays readable even if the quote is
  // later deleted (quoteId goes null on delete, quoteNumber survives).
  quoteId     String?
  quote       Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteNumber String?

  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  // Client-safe details only (e.g. previous/new status, finalPriceRs).
  // Never raw vendor costs or margin percentages — see AuditAction.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
  @@schema("public")
}

// Public, cost-free catalog of selectable equipment for the Custom
// Equipment Builder (app/page.tsx). Deliberately carries NO price —
// `code` is the join key to the matching CONFIDENTIAL RawVendorCost row
// (componentType + itemName = this code), looked up only inside
// lib/db/admin.ts's admin-only boundary. A customer-facing route can
// safely list every EquipmentOption without ever touching vendor_private.
model EquipmentOption {
  id            String        @id @default(cuid())
  componentType ComponentType

  /** Stable join key to RawVendorCost.itemName — e.g. "LONGI_TOPCON_610W".
   *  Never shown to the user; `label` is what renders. */
  code  String
  label String // e.g. "Longi TOPCon 610W"
  brand String?

  /** Informational only (e.g. 610 for panel watts, 10 for battery kWh) —
   *  not used in pricing; the matching RawVendorCost row is. */
  specValue Decimal? @db.Decimal(10, 2)

  /** Restricts which ServiceType this makes sense for (e.g. a "Hybrid
   *  Inverter" option only relevant when HYBRID_BATTERY is selected).
   *  Null = applies regardless of service type. */
  applicableServiceType ServiceType?

  /** The reserved "Other / Specific Requirement" entry every component
   *  type has exactly one of — selecting it means no RawVendorCost
   *  lookup happens for that slot (see CUSTOM_REQUIREMENT handling in
   *  lib/db/admin.ts); the Recommended default's cost is used as a
   *  placeholder and the quote is flagged for manual engineering review. */
  isOtherOption Boolean @default(false)

  /** The Recommended-path default for this componentType (+
   *  applicableServiceType, where relevant) — admin-editable via the
   *  "Default Switch" in /admin/pricing. At most one row should be true
   *  per (componentType, applicableServiceType) combination; enforced in
   *  application code (lib/db/admin.ts's setDefaultMaterial), not a DB
   *  constraint, since "applies regardless of service type" (null) vs a
   *  specific service type share the same componentType. Falls back to a
   *  hardcoded constant in lib/db/admin.ts if nothing is marked default,
   *  so pricing never breaks from an empty admin table. */
  isDefault Boolean @default(false)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /** Inventory guardrail (2026-08-20) — distinct from `isActive`:
   *  `isActive: false` means "discontinued, remove from every catalog
   *  view," `inStock: false` means "still a real, sellable item, just
   *  temporarily unavailable to ship." The public storefront must never
   *  recommend or price an `inStock: false` item (see getDefaultCode()/
   *  calculateSystemPricing()'s inStock filters and the "smallest/
   *  cheapest in-stock" budget-tier helpers in lib/db/admin.ts) — the
   *  Custom Equipment Builder still SHOWS it (greyed out, disabled, "Out
   *  of Stock" badge) so a customer isn't confused about why a
   *  previously-seen brand vanished, it just can't be selected. Defaults
   *  true so every already-seeded row stays exactly as buyable as before
   *  this column existed. */
  inStock Boolean @default(true)

  // Media, hosted on Google Drive (brand logos, official spec PDFs) —
  // always stored in the normalized `https://drive.google.com/uc?export=
  // view&id=FILE_ID` form, never a raw share link, via
  // formatGoogleDriveLink() in lib/utils/googleDrive.ts. That conversion
  // happens server-side in lib/db/admin.ts (createMaterialItem /
  // updateMaterialItem) regardless of what the client already normalized,
  // so these columns are never trusted to already be in the right shape.
  logoUrl     String? @db.Text
  brochureUrl String? @db.Text

  // Ordered key/value comparison specs (e.g. [{"key":"Efficiency",
  // "value":"22.5%"}]) — freeform, admin-entered via /admin/pricing's
  // Dynamic Specs Builder, for customer-facing comparison tables. An
  // array (not an object) so insertion order is preserved and the UI can
  // render/edit it as ordered rows without reshuffling. Null/empty = no
  // specs entered yet.
  specs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([componentType, code])
  @@index([componentType, isActive])
  @@index([componentType, isDefault])
  @@index([componentType, inStock])
  @@map("equipment_options")
  @@schema("public")
}

// ============================================================================
// VENDOR_PRIVATE SCHEMA — Super Admin only (Business Rule #2)
// Never queried by any client- or engineer-facing API route.
// ============================================================================

model RawVendorCost {
  id String @id @default(cuid())

  componentType ComponentType
  vendorName    String
  itemName      String
  model         String?

  unitCostRs Decimal  @db.Decimal(12, 2) // confidential raw cost
  unit       CostUnit
  currency   String   @default("PKR")

  /** Per-item margin override, admin-editable via /admin/pricing. Null =
   *  fall back to the sector's default MarginRule (componentType: null)
   *  — see calculateSystemPricing's effectiveMarginPercent() in
   *  lib/db/admin.ts. Distinct from MarginRule.componentType (which
   *  would apply to every item of that componentType uniformly); this
   *  is per INDIVIDUAL material (e.g. Longi vs Jinko can each carry
   *  their own margin), matching the /admin/pricing table's grain. */
  marginPercentOverride Decimal? @db.Decimal(5, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  notes         String?   @db.Text

  createdById String
  createdBy   User   @relation("VendorCostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  boqItems BoqItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([componentType])
  @@index([isActive])
  @@map("raw_vendor_costs")
  @@schema("vendor_private")
}

model MarginRule {
  id String @id @default(cuid())

  sector        Sector
  componentType ComponentType? // null = applies to whole-system default

  minMarginPercent    Decimal @db.Decimal(5, 2)
  targetMarginPercent Decimal @db.Decimal(5, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdById String
  createdBy   User   @relation("MarginRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([isActive])
  @@map("margin_rules")
  @@schema("vendor_private")
}

/** Singleton settings row (exactly one, enforced by application code —
 *  same "find the current row, update it in place" pattern
 *  `updateGlobalPricingRule()` already uses for `structureCostPerWatt`/
 *  the old flat `installationCostPerWatt` on RawVendorCost) holding rate
 *  knobs that don't fit the per-catalog-item RawVendorCost shape:
 *  sector-specific installation rates, and the two flat add-on-service
 *  rates (EV Charger, Panel Washing) that have no brand/model catalog
 *  entry at all — see lib/db/admin.ts's getGlobalPricingSettings().
 *  Decimal, not Float, for the same reason every other PKR figure in
 *  this schema is Decimal: avoids floating-point rounding drift in
 *  financial calculations. */
model GlobalPricingSettings {
  id String @id @default(cuid())

  installationCostPerWattResidential Decimal @db.Decimal(8, 2)
  installationCostPerWattCommercial  Decimal @db.Decimal(8, 2)
  installationCostPerWattIndustrial  Decimal @db.Decimal(8, 2)
  evChargerInstallationFee           Decimal @db.Decimal(12, 2)

  // Tiered "One-Time Visit" Panel Washing rates (2026-08-21) — replaces
  // the old single flat washingCostPerPanel with 4 volume brackets +
  // a minimum call-out fee floor. See panelWashingRawCostPKR() in
  // lib/db/admin.ts for the exact bracket logic (1-20 / 21-60 / 61-150 /
  // 151+ panels). Shared by BOTH the standalone "System Upgrades &
  // Washing" inquiry flow (unaffected otherwise — its Monthly
  // Subscription discount is just a % off whatever this resolves to)
  // and the new toggleable Custom Equipment Builder option.
  washingRateTier1PerPanel  Decimal @db.Decimal(10, 2)
  washingRateTier2PerPanel  Decimal @db.Decimal(10, 2)
  washingRateTier3PerPanel  Decimal @db.Decimal(10, 2)
  washingRateTier4PerPanel  Decimal @db.Decimal(10, 2)
  washingMinimumVisitFeePKR Decimal @db.Decimal(10, 2)

  // "Site Works" add-ons (2026-08-20) — same flat-rate shape as
  // evChargerInstallationFee/washingCostPerPanel above: no brand/model
  // catalog entry, just an admin-set Rs rate the customer's own picked
  // quantity multiplies against (see calculateSystemPricing's siteWorksPKR
  // in lib/db/admin.ts). Sector-agnostic on purpose — civil/earthing/
  // lightning-protection work doesn't price differently by sector the way
  // installation labor does.
  civilWorkCostPerBlock        Decimal @db.Decimal(10, 2)
  earthingCostPerBore          Decimal @db.Decimal(10, 2)
  lightningArrestorCostPerUnit Decimal @db.Decimal(10, 2)

  updatedById String
  updatedBy   User   @relation("GlobalPricingSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_pricing_settings")
  @@schema("vendor_private")
}
