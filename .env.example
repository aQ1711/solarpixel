# Three separate roles, three separate connection strings — never blend
# them. See prisma/migrations/20260815120000_vendor_isolation_lockdown for
# how each role's privileges are actually enforced at the DB level.

# solar_pixel_admin — DB owner. Full DDL rights. Used ONLY by
# `prisma migrate` / `prisma studio` (see prisma.config.ts). Never used by
# a running app instance.
MIGRATE_DATABASE_URL="postgresql://solar_pixel_admin:password@localhost:5432/solar_pixel?schema=public"

# app_public_role — used by lib/db/client.ts, i.e. every ordinary route
# (Client + Field Engineer facing). Zero access to vendor_private.
DATABASE_URL="postgresql://app_public_role:password@localhost:5432/solar_pixel?schema=public"

# app_admin_role — used ONLY by lib/db/admin.ts, i.e. the secure
# Calculation/Checker admin path. Read/write on vendor_private + public.
ADMIN_DATABASE_URL="postgresql://app_admin_role:password@localhost:5432/solar_pixel?schema=public,vendor_private"

# Public — safe to expose to the browser. Business WhatsApp number (no
# leading +, country code first) used for the "Book Free Site Survey" /
# "Chat with us" wa.me deep links in app/page.tsx.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER="923282155550"

# ⚠️ INTERIM ONLY — see lib/auth/internal-guard.ts. Shared secrets that
# gate /maker/* and /admin/checker/*. NOT real auth (no per-user session,
# no role check) — replace with real login before production. Generate
# real values with: openssl rand -hex 24
MAKER_ACCESS_TOKEN="change-me-maker-token"
ADMIN_ACCESS_TOKEN="change-me-admin-token"
