  },
  {
    icon: Gauge,
    title: "Maximum Daytime Offloading",
    body: "Every system is sized around your actual daytime load — so you offset the expensive peak-tariff units first, not just any units.",
  },
  {
    icon: Wallet,
    title: "Lower Upfront Cost",
    body: "No export-rated inverters, no bi-directional meters, no NEPRA paperwork fees — hardware and approval costs you simply never pay.",
  },
] as const;

function FeaturesSection() {
  return (
    <section className="border-t border-stone-200 px-5 py-16 sm:py-20 print:hidden">
      <div className="mx-auto max-w-5xl">
        <p className="mb-8 text-center text-xs font-semibold uppercase tracking-[0.2em] text-violet-600 sm:mb-10">
          Why Solar Pixel
        </p>
        <div className="grid gap-5 sm:grid-cols-3">
          {FEATURES.map(({ icon: Icon, title, body }, i) => (
            <Reveal key={title} delayMs={i * 100}>
              <div className="relative rounded-2xl border border-stone-200 bg-white p-6">
                <CornerBrackets />
                <div className="flex h-11 w-11 items-center justify-center rounded-xl border border-stone-200 bg-stone-50">
                  <Icon className="h-5 w-5 text-violet-600" />
                </div>
