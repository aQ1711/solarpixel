# Copy this file to .env.scraper.local (gitignored) and fill in the real
# value. See scripts/run-market-scrape.ts's top doc comment for the full
# explanation of why this is a separate file from this repo's own .env.
#
# Get this from the Vercel dashboard: your project -> Settings ->
# Environment Variables -> ADMIN_DATABASE_URL -> Production environment
# -> reveal -> copy. This must be PRODUCTION's app_admin_role connection
# string, not the shared staging one already in .env.
ADMIN_DATABASE_URL="postgresql://app_admin_role:PASTE_PRODUCTION_VALUE_HERE@.../neondb?schema=public,vendor_private&sslmode=require"
